{
  "name": "Backlog Issue Template",
  "version": "0.1.2",
  "manifest_version": 3,
  "description": "課題追加時にテンプレを挿入できるようにします",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.backlog.jp/add/*",
        "https://*.backlog.com/add/*"
      ],
      "js": [
        "run.js"
      ],
      "run_at": "document_idle"
    }
  ]
}